POSTGRES_DB=churn_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=db
POSTGRES_PORT=5432
MLFLOW_TRACKING_URI=http://mlflow:5000
MLFLOW_EXPERIMENT_NAME=churn_prediction
# Optional local fallback only. In production-style setups, prefer Alembic migrations instead of runtime schema creation.
# ENABLE_RUNTIME_DB_BOOTSTRAP=false
# GitHub-hosted automation for Streamlit dispatch and remote-first operation:
# Use the real repository path and branch/ref that contains the workflow files.
# The target ref must already have the same workflow_dispatch inputs as your local workflow YAML.
# AUTOMATION_EXECUTION_MODE=github
# GITHUB_REPOSITORY=your-user-or-org/your-repo
# GITHUB_WORKFLOW_REF=main
# GITHUB_TRAINING_WORKFLOW=training.yml
# GITHUB_MONITORING_WORKFLOW=monitoring.yml
# GitHub token must be allowed to trigger Actions workflows in the target repository.
# GITHUB_ACTIONS_TOKEN=ghp_xxx_or_fine_grained_token
# Optional: override the individual Postgres values above with a single DSN.
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@db:5432/churn_db
# For full remote GitHub automation, configure hosted values as GitHub repository secrets rather than local .env values.
